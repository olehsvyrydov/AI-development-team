{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/claude/memory/src/hooks/restore-context.ts"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/claude/memory/src/hooks/live-directives.ts"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "--no-warnings",
              "${CLAUDE_PLUGIN_ROOT}/claude/memory/src/hooks/save-context.ts"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
